[Unit]
Description=Logind Idle Control Tray Icon
Documentation=https://github.com/MasonRhodesDev/logind-idle-control
PartOf=graphical-session.target
After=graphical-session.target logind-idle-control.service
Wants=logind-idle-control.service

[Service]
Type=simple
ExecStart=/usr/bin/logind-idle-control-tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target

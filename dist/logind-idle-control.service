[Unit]
Description=Logind Idle Control Daemon
Documentation=https://github.com/MasonRhodesDev/logind-idle-control
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/usr/bin/logind-idle-control daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target

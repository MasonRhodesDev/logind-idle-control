# rpmlint filters for logind-idle-control. Lets CI gate on rpmlint without
# tripping over domain vocabulary and our deliberate vendored-source layout.

# Domain terms rpmlint's dictionary doesn't know (systemd, logind, inhibitor,
# StatusNotifierItem, tray, D-Bus, CLI). Not real defects.
addFilter("spelling-error")

# Source1 is the cargo-vendor tarball produced by build-srpm.sh, not a URL —
# intentional (offline, reproducible RPM build).
addFilter("invalid-url Source1")
